# Copy this file to .env and fill in real values. Never commit .env itself.
# Generate random secrets with:  python -c "import secrets; print(secrets.token_urlsafe(24))"

# ── LLM (any OpenAI-compatible endpoint — Groq by default) ────────────────────
# Get a key at https://console.groq.com
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
# Providers rate-limit per model, so agents that run at the same time use
# different models. Empty = defaults (see agent/src/sre_agent/config.py).
SPECIALIST_MODEL=openai/gpt-oss-20b
LOGS_AGENT_MODEL=
METRICS_AGENT_MODEL=qwen/qwen3.8-27b
INFRA_AGENT_MODEL=
# Used, in order, when a model's quota runs out (comma-separated).
LLM_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b

# ── Database ──────────────────────────────────────────────────────────────────
# Read only on FIRST initialisation of the postgres_data volume. After changing
# them, recreate the volume:  docker compose down -v && docker compose up -d
POSTGRES_DB=pocdb
POSTGRES_PASSWORD=change_me_superuser_password
APP_DB_USER=appuser
APP_DB_PASSWORD=change_me_app_password

# ── Agent security ────────────────────────────────────────────────────────────
# Required header (X-API-Key) on every /action/* call; the UI prompts for it once.
AGENT_API_KEY=change_me_agent_api_key
# Enables the backend's /admin/exhaust-pool fault injection. Leave empty to disable.
FAULT_INJECTION_TOKEN=change_me_fault_token

# ── Bundled tooling ───────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
# Portainer requires at least 12 characters. Leave empty to skip auto-setup.
PORTAINER_ADMIN_PASSWORD=change_me_portainer_password
# Leave empty to skip Gitea admin auto-setup.
GITEA_ADMIN_USER=gitea-admin
GITEA_ADMIN_PASSWORD=change_me_gitea_password
GITEA_ADMIN_EMAIL=admin@example.com
